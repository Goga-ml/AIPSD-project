# Copy to .env (gitignored) and fill in. Variables already set in your shell take priority.
# gemini | ollama | mock (mock needs no key and costs nothing)
LLM_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
GROUNDWORK_CHAT_MODEL=gemini-3.8-flash

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
